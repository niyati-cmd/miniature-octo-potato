<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Ping Pong</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏓</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;600&display=swap" rel="stylesheet">
<style>
  :root {
    --floor: #8e3b2a;
    --floor-dark: #6a2a1d;
    --table: #1d5b9e;
    --ball: #ff9a1a;
    --red: #e03131;
    --black: #1c1c1c;
    --card: #f5f5f2;
    --ink: #1c1c1c;
    --cond: "Barlow Condensed", "Arial Narrow", "Roboto Condensed", sans-serif;
    --body: "Barlow", system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  * { box-sizing: border-box; margin: 0; }
  html, body { height: 100%; }
  body {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: max(16px, env(safe-area-inset-top)) 16px max(16px, env(safe-area-inset-bottom));
    background-color: var(--floor);
    background-image: repeating-linear-gradient(90deg, rgba(0,0,0,.05) 0 2px, transparent 2px 140px);
    color: #fff;
    font-family: var(--body);
    line-height: 1.4;
  }

  /* Flip scoreboard */
  .scoreboard {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 20px;
    width: 100%;
    max-width: 960px;
  }
  .side { display: flex; flex-direction: column; gap: 8px; }
  .side.you { align-items: flex-end; }
  .side.cpu { align-items: flex-start; }
  .name {
    display: flex; align-items: center; gap: 8px;
    font-family: var(--cond); font-weight: 600; font-size: 1.25rem; letter-spacing: .02em;
  }
  .rubber { width: 14px; height: 14px; border-radius: 50%; border: 2px solid #fff; }
  .rubber.red { background: var(--red); }
  .rubber.black { background: var(--black); }
  .serving {
    font-size: .8rem; font-family: var(--body); font-weight: 600;
    background: var(--ball); color: var(--ink); padding: 1px 8px; border-radius: 999px;
  }
  .card {
    position: relative;
    width: clamp(68px, 12vw, 108px);
    aspect-ratio: 3 / 4;
    display: grid; place-items: center;
    background: var(--card); color: var(--ink);
    border-radius: 6px;
    box-shadow: 0 4px 0 var(--floor-dark);
    font-family: var(--cond); font-weight: 700;
    font-size: clamp(46px, 8vw, 80px); line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .card::after {
    content: ""; position: absolute; left: 0; right: 0; top: 50%;
    height: 2px; background: rgba(0,0,0,.18);
  }
  .card.flip { animation: flip .28s ease-out; }
  @keyframes flip {
    from { transform: perspective(320px) rotateX(-75deg); }
    to { transform: none; }
  }
  .target {
    font-family: var(--cond); font-weight: 600; font-size: 1rem;
    padding-bottom: 14px; opacity: .85; text-align: center;
  }

  /* Table */
  .table-wrap {
    width: 100%; max-width: 960px;
    aspect-ratio: 9 / 5;
    border-radius: 4px;
    box-shadow: 0 16px 0 rgba(0,0,0,.2);
  }
  canvas {
    display: block; width: 100%; height: 100%;
    border-radius: 4px;
    touch-action: none; cursor: none;
  }
  canvas:focus-visible { outline: 3px solid var(--ball); outline-offset: 4px; }

  /* Controls */
  .controls {
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px;
  }
  .difficulty { display: flex; border: 2px solid #fff; border-radius: 6px; overflow: hidden; }
  button {
    font: 600 1rem var(--body); color: #fff; background: transparent;
    border: 0; padding: 8px 16px; cursor: pointer;
  }
  .difficulty button + button { border-left: 2px solid #fff; }
  .difficulty button[aria-pressed="true"] { background: #fff; color: var(--ink); }
  .solo { border: 2px solid #fff; border-radius: 6px; }
  .solo.primary { background: var(--ball); border-color: var(--ball); color: var(--ink); }
  button:focus-visible { outline: 3px solid var(--ball); outline-offset: 2px; }
  .status { font-family: var(--cond); font-weight: 600; font-size: 1.4rem; text-align: center; }
  .help { font-size: .9rem; opacity: .8; text-align: center; max-width: 60ch; }

  @media (max-width: 560px) {
    .scoreboard { gap: 10px; }
    .name { font-size: 1.05rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card.flip { animation: none; }
  }
</style>
</head>
<body>

<header class="scoreboard" aria-live="polite">
  <div class="side you">
    <span class="name"><span class="serving" id="serveYou">Serving</span>You <span class="rubber red" aria-hidden="true"></span></span>
    <div class="card" id="scoreYou" aria-label="Your score">0</div>
  </div>
  <div class="target">First to 11,<br>win by 2</div>
  <div class="side cpu">
    <span class="name"><span class="rubber black" aria-hidden="true"></span> Computer <span class="serving" id="serveCpu" hidden>Serving</span></span>
    <div class="card" id="scoreCpu" aria-label="Computer score">0</div>
  </div>
</header>

<div class="table-wrap">
  <canvas id="game" tabindex="0" aria-label="Ping pong table. Move your paddle with the mouse, touch, or W/S and arrow keys."></canvas>
</div>

<p class="status" id="status" role="status">Press Space or tap the table to serve.</p>

<div class="controls">
  <div class="difficulty" role="group" aria-label="Difficulty">
    <button type="button" data-level="easy" aria-pressed="false">Easy</button>
    <button type="button" data-level="normal" aria-pressed="true">Normal</button>
    <button type="button" data-level="hard" aria-pressed="false">Hard</button>
  </div>
  <button type="button" class="solo" id="sound" aria-pressed="true">Sound on</button>
  <button type="button" class="solo primary" id="again" hidden>Play again</button>
</div>

<p class="help">Move your paddle with the mouse, your finger, or W/S and the arrow keys. Press P to pause.</p>

<script>
(() => {
  // ---- Setup ----
  const W = 900, H = 500;             // logical table size
  const PW = 14, PH = 90, R = 9;      // paddle width/height, ball radius
  const PLAYER_SPEED = 520;           // px per second (keyboard)
  const START_SPEED = 430, MAX_SPEED = 950, SPEEDUP = 1.05;
  const MAX_ANGLE = 55 * Math.PI / 180;
  const COLORS = { table: "#1d5b9e", line: "#ffffff", ball: "#ff9a1a", red: "#e03131", black: "#1c1c1c" };
  const LEVELS = {
    easy:   { speed: 250, error: 45, react: 0.55 },
    normal: { speed: 370, error: 24, react: 0.35 },
    hard:   { speed: 520, error: 10, react: 0.15 }
  };

  const canvas = document.getElementById("game");
  const ctx = canvas.getContext("2d");
  const $ = id => document.getElementById(id);
  const scoreYouEl = $("scoreYou"), scoreCpuEl = $("scoreCpu");
  const statusEl = $("status"), againBtn = $("again"), soundBtn = $("sound");

  const player = { x: 30, y: H / 2 - PH / 2 };
  const cpu = { x: W - 30 - PW, y: H / 2 - PH / 2 };
  const ball = { x: W / 2, y: H / 2, vx: 0, vy: 0, speed: START_SPEED };
  const keys = { up: false, down: false };
  let pointerY = null;
  let score = { you: 0, cpu: 0 };
  let state = "ready";                // ready | playing | paused | over
  let pausedFrom = "ready";
  let level = LEVELS.normal;
  let cpuAim = 0;
  let cpuServeTimer = 0;
  let soundOn = true, audio = null;
  let scale = 1;

  // ---- Canvas sizing (sharp on high-DPI screens) ----
  function resize() {
    const rect = canvas.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvas.width = Math.round(rect.width * dpr);
    canvas.height = Math.round(rect.height * dpr);
    scale = rect.width / W;
    ctx.setTransform(scale * dpr, 0, 0, scale * dpr, 0, 0);
  }
  window.addEventListener("resize", resize);

  // ---- Sound ----
  function blip(freq, dur = 0.06) {
    if (!soundOn) return;
    try {
      audio = audio || new (window.AudioContext || window.webkitAudioContext)();
      const osc = audio.createOscillator(), gain = audio.createGain();
      osc.type = "square"; osc.frequency.value = freq;
      gain.gain.setValueAtTime(0.06, audio.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, audio.currentTime + dur);
      osc.connect(gain).connect(audio.destination);
      osc.start(); osc.stop(audio.currentTime + dur);
    } catch (e) { /* sound not available */ }
  }

  // ---- Rules ----
  function server() {
    // Serve changes every 2 points; at 10–10 it changes every point.
    const total = score.you + score.cpu;
    const turn = total < 20 ? Math.floor(total / 2) % 2 : total % 2;
    return turn === 0 ? "you" : "cpu";
  }
  function winner() {
    if (score.you >= 11 && score.you - score.cpu >= 2) return "you";
    if (score.cpu >= 11 && score.cpu - score.you >= 2) return "cpu";
    return null;
  }

  function setStatus(text) { statusEl.textContent = text; }

  function updateScoreboard(changed) {
    scoreYouEl.textContent = score.you;
    scoreCpuEl.textContent = score.cpu;
    const el = changed === "you" ? scoreYouEl : changed === "cpu" ? scoreCpuEl : null;
    if (el) { el.classList.remove("flip"); void el.offsetWidth; el.classList.add("flip"); }
    const s = server();
    $("serveYou").hidden = s !== "you" || state === "over";
    $("serveCpu").hidden = s !== "cpu" || state === "over";
  }

  function readyForServe() {
    state = "ready";
    ball.vx = ball.vy = 0;
    ball.speed = START_SPEED;
    if (server() === "you") {
      setStatus("Your serve. Press Space or tap the table.");
    } else {
      setStatus("Computer is serving…");
      cpuServeTimer = 0.9;
    }
    updateScoreboard();
  }

  function serve() {
    const s = server();
    const dir = s === "you" ? 1 : -1;
    const angle = (Math.random() * 0.6 - 0.3);
    ball.speed = START_SPEED;
    ball.vx = dir * ball.speed * Math.cos(angle);
    ball.vy = ball.speed * Math.sin(angle);
    cpuAim = (Math.random() * 2 - 1) * level.error;
    state = "playing";
    setStatus("");
    blip(520);
  }

  function pointTo(who) {
    score[who]++;
    blip(who === "you" ? 780 : 220, 0.15);
    const win = winner();
    if (win) {
      state = "over";
      updateScoreboard(who);
      setStatus(win === "you"
        ? `You win ${score.you}–${score.cpu}!`
        : `Computer wins ${score.cpu}–${score.you}. Try again?`);
      againBtn.hidden = false;
      againBtn.focus();
      return;
    }
    updateScoreboard(who);
    readyForServe();
  }

  function newGame() {
    score = { you: 0, cpu: 0 };
    againBtn.hidden = true;
    updateScoreboard();
    readyForServe();
    canvas.focus();
  }

  function togglePause() {
    if (state === "paused") {
      state = pausedFrom;
      setStatus(state === "ready" && server() === "you" ? "Your serve. Press Space or tap the table." : "");
    } else if (state === "playing" || state === "ready") {
      pausedFrom = state;
      state = "paused";
      setStatus("Paused. Press P to continue.");
    }
  }

  // ---- Update ----
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

  function update(dt) {
    if (state === "paused" || state === "over") return;

    // Player paddle
    if (keys.up) { player.y -= PLAYER_SPEED * dt; pointerY = null; }
    if (keys.down) { player.y += PLAYER_SPEED * dt; pointerY = null; }
    if (pointerY !== null) player.y += (pointerY - (player.y + PH / 2)) * Math.min(1, dt * 18);
    player.y = clamp(player.y, 0, H - PH);

    // Computer paddle
    let target = H / 2;
    if (ball.vx > 0 && ball.x > W * level.react) target = ball.y + cpuAim;
    if (state === "ready" && server() === "cpu") target = cpu.y + PH / 2;
    const diff = target - (cpu.y + PH / 2);
    const step = level.speed * dt;
    cpu.y += Math.abs(diff) < step ? diff : Math.sign(diff) * step;
    cpu.y = clamp(cpu.y, 0, H - PH);

    // Waiting to serve: ball sits in front of the server's paddle
    if (state === "ready") {
      if (server() === "you") { ball.x = player.x + PW + R + 2; ball.y = player.y + PH / 2; }
      else {
        ball.x = cpu.x - R - 2; ball.y = cpu.y + PH / 2;
        cpuServeTimer -= dt;
        if (cpuServeTimer <= 0) serve();
      }
      return;
    }

    // Ball movement
    const prevX = ball.x;
    ball.x += ball.vx * dt;
    ball.y += ball.vy * dt;

    if (ball.y - R < 0) { ball.y = R; ball.vy = Math.abs(ball.vy); blip(300, 0.03); }
    if (ball.y + R > H) { ball.y = H - R; ball.vy = -Math.abs(ball.vy); blip(300, 0.03); }

    // Paddle hits (checks crossing the paddle face, so fast balls can't skip through)
    if (ball.vx < 0) {
      const face = player.x + PW;
      if (prevX - R >= face && ball.x - R <= face &&
          ball.y + R >= player.y && ball.y - R <= player.y + PH) {
        hit(player, 1, face + R);
      }
    } else if (ball.vx > 0) {
      const face = cpu.x;
      if (prevX + R <= face && ball.x + R >= face &&
          ball.y + R >= cpu.y && ball.y - R <= cpu.y + PH) {
        hit(cpu, -1, face - R);
      }
    }

    // Points
    if (ball.x < -R * 3) pointTo("cpu");
    else if (ball.x > W + R * 3) pointTo("you");
  }

  function hit(paddle, dir, newX) {
    const rel = clamp((ball.y - (paddle.y + PH / 2)) / (PH / 2), -1, 1);
    const angle = rel * MAX_ANGLE;
    ball.speed = Math.min(ball.speed * SPEEDUP, MAX_SPEED);
    ball.vx = dir * ball.speed * Math.cos(angle);
    ball.vy = ball.speed * Math.sin(angle);
    ball.x = newX;
    if (dir === 1) cpuAim = (Math.random() * 2 - 1) * level.error;
    blip(dir === 1 ? 640 : 480);
  }

  // ---- Drawing ----
  function roundRect(x, y, w, h, r, color) {
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
    ctx.fill();
  }

  function draw() {
    // Table surface and lines
    ctx.fillStyle = COLORS.table;
    ctx.fillRect(0, 0, W, H);
    ctx.strokeStyle = COLORS.line;
    ctx.lineWidth = 6;
    ctx.strokeRect(3, 3, W - 6, H - 6);
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(0, H / 2); ctx.lineTo(W, H / 2); ctx.stroke();

    // Net
    ctx.fillStyle = "rgba(255,255,255,.85)";
    ctx.fillRect(W / 2 - 3, 0, 6, H);
    ctx.fillStyle = "rgba(0,0,0,.28)";
    for (let y = 0; y < H; y += 10) ctx.fillRect(W / 2 - 3, y, 6, 2);

    // Paddles
    roundRect(player.x, player.y, PW, PH, 6, COLORS.red);
    roundRect(cpu.x, cpu.y, PW, PH, 6, COLORS.black);

    // Ball with shadow
    ctx.fillStyle = "rgba(0,0,0,.25)";
    ctx.beginPath(); ctx.arc(ball.x + 4, ball.y + 5, R, 0, Math.PI * 2); ctx.fill();
    ctx.fillStyle = COLORS.ball;
    ctx.beginPath(); ctx.arc(ball.x, ball.y, R, 0, Math.PI * 2); ctx.fill();

    if (state === "paused") {
      ctx.fillStyle = "rgba(0,0,0,.4)";
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = "#fff";
      ctx.font = "700 64px 'Barlow Condensed', 'Arial Narrow', sans-serif";
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
      ctx.fillText("Paused", W / 2, H / 2);
    }
  }

  // ---- Loop ----
  let last = performance.now();
  function frame(now) {
    const dt = Math.min((now - last) / 1000, 1 / 30);
    last = now;
    update(dt);
    draw();
    requestAnimationFrame(frame);
  }

  // ---- Input ----
  function toTableY(e) {
    const rect = canvas.getBoundingClientRect();
    return (e.clientY - rect.top) / rect.height * H;
  }
  canvas.addEventListener("pointermove", e => { pointerY = toTableY(e); });
  canvas.addEventListener("pointerdown", e => {
    pointerY = toTableY(e);
    canvas.focus();
    if (state === "ready" && server() === "you") serve();
  });

  document.addEventListener("keydown", e => {
    const k = e.key.toLowerCase();
    if (k === "arrowup" || k === "w") { keys.up = true; e.preventDefault(); }
    if (k === "arrowdown" || k === "s") { keys.down = true; e.preventDefault(); }
    if (k === "p" || k === "escape") togglePause();
    if (k === " " && e.target.tagName !== "BUTTON") {
      e.preventDefault();
      if (state === "ready" && server() === "you") serve();
      else if (state === "over") newGame();
    }
  });
  document.addEventListener("keyup", e => {
    const k = e.key.toLowerCase();
    if (k === "arrowup" || k === "w") keys.up = false;
    if (k === "arrowdown" || k === "s") keys.down = false;
  });
  document.addEventListener("visibilitychange", () => {
    if (document.hidden && (state === "playing" || state === "ready")) togglePause();
  });

  document.querySelectorAll(".difficulty button").forEach(btn => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".difficulty button").forEach(b => b.setAttribute("aria-pressed", "false"));
      btn.setAttribute("aria-pressed", "true");
      level = LEVELS[btn.dataset.level];
      canvas.focus();
    });
  });
  soundBtn.addEventListener("click", () => {
    soundOn = !soundOn;
    soundBtn.setAttribute("aria-pressed", String(soundOn));
    soundBtn.textContent = soundOn ? "Sound on" : "Sound off";
  });
  againBtn.addEventListener("click", newGame);

  // ---- Start ----
  resize();
  readyForServe();
  requestAnimationFrame(frame);
})();
</script>
</body>
</html>
